# Update Homebrew, neovim plugins, tmux plugins, mise, OSX
function osx-update() {
  # homebrew
  /usr/local/dotfiles/brew.sh

  # neovim plugins (clean + install + update; commits lazy-lock.json changes are manual)
  nvim --headless "+Lazy! sync" +qa

  # mason LSP updates
  nvim --headless "+MasonUpdate" +qa

  # tmux plugin manager
  ~/.tmux/plugins/tpm/bin/clean_plugins
  ~/.tmux/plugins/tpm/bin/install_plugins
  ~/.tmux/plugins/tpm/bin/update_plugins all

  # mise
  mise upgrade

  # OSX update
  mas upgrade
  sudo -A softwareupdate --all --install --force
  echo "To reboot: sudo shutdown -r now"

  # omz update
  omz update
}
